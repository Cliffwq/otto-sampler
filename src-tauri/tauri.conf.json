{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otto-Sampler",
  "version": "0.1.1",
  "identifier": "com.cliff.tauri-app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OTTO Sampler",
        "width": 480,
        "height": 720,
        "visible": false,
        "dragDropEnabled": false,
        "decorations": false,
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "THIRD_PARTY_NOTICES.txt"
    ]
  }
}
